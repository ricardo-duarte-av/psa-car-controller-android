<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theming (MaterialExpressiveTheme); this only styles the window
         chrome shown before the first frame. Edge-to-edge is enabled in code. -->
    <style name="Theme.Psacc" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>
</resources>
